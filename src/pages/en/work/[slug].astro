---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ProjectDetail from "../../../components/project/ProjectDetail.astro";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const projects = (await getCollection("projects")).filter((entry) => entry.data.lang === "en");
  return projects.map((project) => ({
    params: { slug: project.data.routeSlug },
    props: { project },
  }));
}

const lang = "en" as const;
const { project } = Astro.props as { project: CollectionEntry<"projects"> };
const { Content, headings } = await render(project);
---

<BaseLayout lang={lang} title={project.data.title} description={project.data.description}>
  <ProjectDetail project={project} lang={lang} Content={Content} headings={headings} />
</BaseLayout>
