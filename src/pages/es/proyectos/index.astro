---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ProjectCard from "../../../components/project/ProjectCard.astro";
import { getCollection } from "astro:content";
import { t } from "../../../i18n";

const lang = "es" as const;
const projects = (await getCollection("projects")).filter((entry) => entry.data.lang === lang).sort(
  (a, b) => a.data.featuredOrder - b.data.featuredOrder ||
    b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf()
);
---

<BaseLayout lang={lang} title={t(lang, "work.title")} description={t(lang, "meta.description.work")}>
  <div class="section-padding">
    <div class="mx-auto max-w-5xl px-4">
      <h1 class="animate-fade-up text-3xl font-bold tracking-tight text-(--color-text-primary) sm:text-4xl">{t(lang, "work.title")}</h1>
      <p class="animate-fade-up-delay-1 mt-4 max-w-2xl leading-relaxed text-(--color-text-secondary)">{t(lang, "work.subtitle")}</p>

      <div class="mt-12 grid gap-6 sm:grid-cols-2">
        {
          projects.map((project, i) => (
            <ProjectCard
              project={project}
              lang={lang}
              eager={i < 2}
              class={i === 0 ? "animate-fade-up" : i === 1 ? "animate-fade-up-delay-1" : i === 2 ? "animate-fade-up-delay-2" : ""}
            />
          ))
        }
      </div>

      <div class="mt-8">
        <p class="text-sm text-(--color-text-tertiary)">
          {t(lang, "home.featured.confidentiality")}
        </p>
      </div>
    </div>
  </div>
</BaseLayout>
