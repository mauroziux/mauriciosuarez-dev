---
interface Props {
  lang: "en" | "es";
}

import { t, getRoute } from "../i18n";
import { getCollection } from "astro:content";
import SectionHeading from "./SectionHeading.astro";
import ProjectCard from "./project/ProjectCard.astro";

const { lang } = Astro.props;

const workRouteBase = getRoute(lang, "work");

const projects = (await getCollection("projects"))
  .filter((entry) => entry.data.lang === lang && entry.data.featured !== false)
  .sort(
    (a, b) =>
      a.data.featuredOrder - b.data.featuredOrder ||
      b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf(),
  )
  .slice(0, 4);
---

<section class="section-padding">
  <div class="mx-auto max-w-4xl px-4">
    <SectionHeading text={t(lang, "home.featured.heading")} />
    <p class="animate-fade-up mt-4 max-w-lg leading-relaxed text-(--color-text-secondary)">
      {t(lang, "home.featured.subtitle")}
    </p>

    <div class="mt-10 grid gap-6 sm:grid-cols-2">
      {
        projects.map((project, i) => (
          <ProjectCard
            project={project}
            lang={lang}
            eager={i === 0}
            class={i === 0 ? "animate-fade-up" : i === 1 ? "animate-fade-up-delay-1" : i === 2 ? "animate-fade-up-delay-2" : ""}
          />
        ))
      }
    </div>

    <div class="animate-fade-up-delay-3 mt-8">
      <a href={getRoute(lang, "work")} class="link-accent text-sm font-medium">
        {t(lang, "home.featured.viewAll")}
      </a>
    </div>
  </div>
</section>
