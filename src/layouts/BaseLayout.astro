---
import "../styles/global.css";
import { t, getRoute, getAlternateUrl } from "../i18n";
import type { Lang } from "../i18n";

interface Props {
  lang: Lang;
  title: string;
  description: string;
  showSiteChrome?: boolean;
  /** Overrides the nav language-switch href (e.g. sibling article, or the alternate writing index). */
  languageSwitchUrl?: string;
  /** undefined = derive hreflang targets from the current URL (legacy behavior); string = emit hreflang en/es/x-default against this sibling URL; null = emit no hreflang links. */
  alternateUrl?: string | null;
  ogType?: "website" | "article";
  articlePublishedTime?: Date;
  articleModifiedTime?: Date;
  /** Local "/..." path (prefixed with the site origin) or absolute http(s) URL; defaults to /og-image.png. */
  ogImage?: string;
}

const {
  lang,
  title,
  description,
  showSiteChrome = true,
  languageSwitchUrl,
  alternateUrl: alternateUrlProp,
  ogType = "website",
  articlePublishedTime,
  articleModifiedTime,
  ogImage,
} = Astro.props;
const alternateLang: Lang = lang === "en" ? "es" : "en";
const navSwitchUrl = languageSwitchUrl ?? getAlternateUrl(Astro.url, alternateLang);
const canonicalUrl = Astro.url.href;
const siteOrigin = Astro.site?.origin ?? "https://mauriciosuarez.dev";
const siteName = "mauriciosuarez.dev";

// hreflang targets: legacy derivation, or the current page + an explicit sibling URL.
const hreflangEn =
  alternateUrlProp === undefined
    ? `${siteOrigin}${getAlternateUrl(Astro.url, "en")}`
    : lang === "en"
      ? canonicalUrl
      : alternateUrlProp;
const hreflangEs =
  alternateUrlProp === undefined
    ? `${siteOrigin}${getAlternateUrl(Astro.url, "es")}`
    : lang === "es"
      ? canonicalUrl
      : alternateUrlProp;

function resolveOgImage(value?: string): string {
  const image = value ?? "/og-image.png";
  return /^https?:\/\//.test(image) ? image : `${siteOrigin}${image}`;
}
const ogImageUrl = resolveOgImage(ogImage);
const year = new Date().getFullYear();
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | mauriciosuarez.dev</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {alternateUrlProp !== null && (
      <>
        <link rel="alternate" hreflang="en" href={hreflangEn} />
        <link rel="alternate" hreflang="es" href={hreflangEs} />
        <link rel="alternate" hreflang="x-default" href={hreflangEn} />
      </>
    )}
    <link rel="alternate" type="application/rss+xml" title={`${siteName} — Writing (EN)`} href={`${siteOrigin}/en/rss.xml`} />
    <link rel="alternate" type="application/rss+xml" title={`${siteName} — Artículos (ES)`} href={`${siteOrigin}/es/rss.xml`} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    {ogType === "article" && articlePublishedTime && (
      <meta property="article:published_time" content={articlePublishedTime.toISOString()} />
    )}
    {ogType === "article" && articleModifiedTime && (
      <meta property="article:modified_time" content={articleModifiedTime.toISOString()} />
    )}
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={lang === "en" ? "en_US" : "es_ES"} />
    <meta property="og:locale:alternate" content={lang === "en" ? "es_ES" : "en_US"} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={ogImageUrl} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen bg-(--color-bg-primary) text-(--color-text-primary) antialiased">
    <header hidden={!showSiteChrome} class="sticky top-0 z-50 border-b border-(--color-border-primary) bg-(--color-bg-primary)/80 backdrop-blur-md">
      <nav class="mx-auto flex w-full max-w-4xl flex-wrap items-center justify-between gap-x-6 gap-y-3 px-4 py-4">
        <a
          href={getRoute(lang, "home")}
          class="text-sm font-semibold tracking-tight text-(--color-text-primary) transition-colors hover:text-(--color-accent-light)"
        >
          mauriciosuarez<span class="text-(--color-accent-light)">.dev</span>
        </a>
        <div class="flex items-center gap-3 text-sm whitespace-nowrap sm:gap-5">
          <a href={getRoute(lang, "work")} class="text-(--color-text-secondary) transition-colors hover:text-(--color-text-primary)">
            {t(lang, "nav.work")}
          </a>
          <a href={getRoute(lang, "writing")} class="hidden text-(--color-text-secondary) transition-colors hover:text-(--color-text-primary) sm:inline">
            {t(lang, "nav.writing")}
          </a>
          <a href={getRoute(lang, "about")} class="text-(--color-text-secondary) transition-colors hover:text-(--color-text-primary)">
            {t(lang, "nav.about")}
          </a>
          <a href={getRoute(lang, "contact")} class="text-(--color-text-secondary) transition-colors hover:text-(--color-text-primary)">
            {t(lang, "nav.contact")}
          </a>
          <a href={getRoute(lang, "services")} class="hidden text-(--color-text-secondary) transition-colors hover:text-(--color-text-primary) sm:inline">
            {t(lang, "nav.services")}
          </a>
          <span class="mx-1 hidden h-4 w-px bg-(--color-border-secondary) sm:block" aria-hidden="true"></span>
          <a
            href={navSwitchUrl}
            class="rounded-md border border-(--color-border-secondary) px-2.5 py-1 text-xs font-medium text-(--color-text-secondary) transition-colors hover:border-(--color-accent-dim) hover:text-(--color-text-primary)"
            aria-label={`Switch to ${alternateLang === "en" ? "English" : "Español"}`}
          >
            {alternateLang.toUpperCase()}
          </a>
        </div>
      </nav>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer hidden={!showSiteChrome} class="border-t border-(--color-border-primary)">
      <div class="mx-auto flex w-full max-w-4xl flex-wrap items-center justify-between gap-3 px-4 py-8 text-xs text-(--color-text-secondary)">
        <span>&copy; {year} Mauricio Suárez. {t(lang, "footer.rights")}</span>
        <a href={getRoute(lang, "home")} class="transition-colors hover:text-(--color-text-secondary)">
          mauriciosuarez.dev
        </a>
      </div>
    </footer>
  </body>
</html>
